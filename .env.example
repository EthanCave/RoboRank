# RobotEvents API token (https://events.vex.com/api/v2 — create one under your RobotEvents account settings)
ROBOTEVENTS_API_TOKEN=

# Shared team password for signing in (required in production)
ROBORANK_LOGIN_PASSWORD=

# Signs session cookies; use a long random string (required in production)
SESSION_SECRET=

# Team shown by default at login
ROBORANK_DEFAULT_TEAM=355V

# Optional
# ROBOTEVENTS_BASE_URL=https://events.vex.com/api/v2
# DATA_DIR=./data            # where roborank.sqlite lives
# COOKIE_SECURE=false        # only if serving production over plain HTTP
